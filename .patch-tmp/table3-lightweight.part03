+            path_text=archive_file,
+        ).grid(row=0, column=0, sticky="nsew", padx=(0, 12))
+        tk.Label(
+            group,
+            text="DIRECT",
+            background=SCORE_BG,
+            foreground=SCORE_TEXT,
+            font=(gui_font_family, 9, "bold"),
+            padx=9,
+            pady=6,
+        ).grid(row=0, column=1, padx=4, pady=(10, 0), sticky="n")
+        make_direct_file_card(
+            group,
+            role="JSON",
+            title=str(row.get("json_title", Path(json_file).stem)),
+            path_text=json_file,
+            related_files=related_files,
+        ).grid(row=0, column=2, sticky="nsew", padx=(12, 12))
+        make_direct_image_card(
+            group,
+            image_file,
+            archive_file,
+            30 + row_index * 20,
+        ).grid(row=0, column=3, sticky="n")
+
+        footer = tk.Frame(gallery, background=PAGE_BG)
+        footer.pack(fill="x", padx=12, pady=(-8, 10))
+        tk.Button(
+            footer,
+            text=(
