+            tk.Frame(card, background=CARD_BORDER, height=1).pack(
+                fill="x", pady=(8, 6)
+            )
+            tk.Label(
+                card,
+                text=f"DIRECT SIBLING FILES ({len(related_files)})",
+                background=PAGE_BG,
+                foreground=TEXT_MUTED,
+                font=(gui_font_family, 8, "bold"),
+                anchor="w",
+            ).pack(fill="x")
+            for related in related_files[:12]:
+                tk.Button(
+                    card,
+                    text=Path(related).name,
+                    command=lambda p=related: open_existing(p),
+                    background=PAGE_BG,
+                    activebackground=PAGE_BG,
+                    foreground=LINK_TEXT,
+                    activeforeground=LINK_TEXT,
+                    font=(gui_font_family, 9, "underline"),
+                    anchor="w",
+                    justify="left",
+                    wraplength=440,
+                    relief="flat",
+                    borderwidth=0,
+                    highlightthickness=0,
+                    cursor="hand2",
+                    padx=0,
+                    pady=0,
+                ).pack(fill="x", pady=(2, 0))
+            if len(related_files) > 12:
+                tk.Label(
+                    card,
+                    text=f"…and {len(related_files) - 12} more",
+                    background=PAGE_BG,
+                    foreground=TEXT_MUTED,
+                    font=(gui_font_family, 9),
+                    anchor="w",
+                ).pack(fill="x", pady=(2, 0))
+        return card
+
+    def make_direct_image_card(
+        parent: "tk.Misc",
+        image_file: str,
+        archive_file: str,
+        delay_ms: int,
+    ) -> "tk.Frame":
+        """Show the direct sibling image; never open or inspect the CBZ."""
+        card = tk.Frame(
+            parent,
+            background=PAGE_BG,
+            highlightbackground=CARD_BORDER,
+            highlightthickness=1,
+            padx=8,
+            pady=8,
+        )
+        label = tk.Label(
+            card,
+            text=Path(image_file).name if image_file else "No direct image",
+            background=PAGE_BG,
+            foreground=TEXT_MUTED,
+            wraplength=180,
+            padx=8,
+            pady=26,
+        )
+        label.pack()
+
+        def load_direct_image() -> None:
+            if not image_file:
+                return
+            try:
+                photo = tk.PhotoImage(file=image_file)
+                factor = max(
+                    1,
+                    (photo.width() + 189) // 190,
+                    (photo.height() + 249) // 250,
+                )
+                if factor > 1:
+                    photo = photo.subsample(factor, factor)
+                label.configure(image=photo, text="", cursor="hand2")
+                label.image = photo  # type: ignore[attr-defined]
+            except (tk.TclError, OSError):
+                label.configure(text=Path(image_file).name)
+
+        # Rows and filenames paint first. Existing PNG previews follow afterward.
+        root.after(max(1, delay_ms), load_direct_image)
+        tk.Button(
+            card,
+            text="OPEN ARCHIVE ↗",
+            command=lambda p=archive_file: open_existing(p),
+            background=PAGE_BG,
+            activebackground=PAGE_BG,
+            foreground=LINK_TEXT,
+            activeforeground=LINK_TEXT,
+            font=(gui_font_family, 8, "bold", "underline"),
+            relief="flat",
+            borderwidth=0,
+            highlightthickness=0,
+            cursor="hand2",
+        ).pack(pady=(7, 0))
+        return card
+
+    def add_combined_directory_group(
+        gallery: "tk.Frame",
