+def scan_combined_directories(
+    run_directory: Path,
+    *,
+    enforce_limits: bool = False,
+    max_images: int = 1,
+    max_archives: int = 1,
+) -> tuple[list[dict[str, Any]], list[tuple[str, str]]]:
+    """Return one lightweight row per direct pairing directory.
+
+    This is intentionally a filename-only inventory. It does not open SQLite,
+    parse JSON, inspect CBZ/ZIP contents, search historical runs, or recurse below
+    each pairing directory. A row needs at least one direct CBZ/ZIP and one direct
+    JSON. Every other direct file is retained as a sibling/related file.
+    """
+    run_directory = run_directory.expanduser().resolve()
+    if not run_directory.is_dir():
+        return [], [(str(run_directory), "run directory does not exist")]
+    if max_images < 0 or max_archives < 0:
+        raise ValueError("Maximum image/archive limits must be zero or greater.")
+
+    rows: list[dict[str, Any]] = []
+    ignored: list[tuple[str, str]] = []
+    directories = sorted(
+        (
+            entry
+            for entry in run_directory.iterdir()
+            if entry.is_dir()
+            and not entry.name.startswith(".")
+            and entry.name != "manifest-backups"
+            and not entry.name.startswith("_shared_")
+        ),
+        key=lambda entry: entry.name.casefold(),
+    )
+
+    for directory in directories:
+        try:
+            direct_files = sorted(
+                (entry for entry in directory.iterdir() if entry.is_file()),
+                key=lambda entry: entry.name.casefold(),
+            )
+        except OSError as exc:
+            ignored.append((str(directory), f"could not list direct files: {exc}"))
+            continue
+
+        archives = [
+            entry
+            for entry in direct_files
+            if entry.suffix.casefold() in SUPPORTED_ARCHIVE_SUFFIXES
+        ]
+        jsons = [
+            entry for entry in direct_files if entry.suffix.casefold() == ".json"
+        ]
+        images = [entry for entry in direct_files if _is_direct_image_file(entry)]
+
+        if not archives or not jsons:
+            reason = []
+            if not archives:
+                reason.append("no direct CBZ/ZIP")
+            if not jsons:
+                reason.append("no direct JSON")
+            ignored.append((str(directory), " and ".join(reason)))
+            continue
+        if enforce_limits and len(images) > max_images:
+            ignored.append(
+                (str(directory), f"{len(images)} direct images exceeds {max_images}")
+            )
+            continue
+        if enforce_limits and len(archives) > max_archives:
+            ignored.append(
+                (str(directory), f"{len(archives)} direct archives exceeds {max_archives}")
+            )
+            continue
+
+        # Deterministic filename-only choices. No metadata or archive is opened.
+        directory_key = unicode_words(_combined_directory_base_name(directory.name))
+        exact_jsons = [
+            entry for entry in jsons if unicode_words(entry.stem) == directory_key
+        ]
+        primary_json = exact_jsons[0] if exact_jsons else jsons[0]
+        primary_archive = archives[0]
+
+        json_key = unicode_words(primary_json.stem)
+        archive_key = unicode_words(primary_archive.stem)
+        image_candidates = sorted(
+            images,
+            key=lambda entry: (
+                0 if entry.suffix.casefold() == ".png" else 1,
+                0
+                if unicode_words(entry.stem) in {json_key, archive_key}
+                else 1,
+                entry.name.casefold(),
+            ),
+        )
+        direct_image = image_candidates[0] if image_candidates else None
+        related_files = [
+            entry
+            for entry in direct_files
+            if entry not in {primary_archive, primary_json}
+        ]
+
+        rows.append(
+            {
+                "destination_directory": str(directory),
+                "destination_archive": str(primary_archive),
+                "destination_json": str(primary_json),
+                "direct_image": str(direct_image) if direct_image is not None else "",
+                "direct_files": [str(entry) for entry in direct_files],
+                "related_files": [str(entry) for entry in related_files],
+                "archive_title": primary_archive.stem,
