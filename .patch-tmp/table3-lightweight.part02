+    def make_direct_file_card(
+        parent: "tk.Misc",
+        *,
+        role: str,
+        title: str,
+        path_text: str,
+        related_files: Sequence[str] = (),
+    ) -> "tk.Frame":
+        """Create a small Table 3 card without metadata or archive inspection."""
+        card = tk.Frame(
+            parent,
+            background=PAGE_BG,
+            highlightbackground=CARD_BORDER,
+            highlightthickness=1,
+            padx=12,
+            pady=10,
+        )
+        tk.Label(
+            card,
+            text=role.upper(),
+            background=PAGE_BG,
+            foreground=TEXT_MUTED,
+            font=(gui_font_family, 8, "bold"),
+            anchor="w",
+        ).pack(fill="x")
+        tk.Label(
+            card,
+            text=title or Path(path_text).name,
+            background=PAGE_BG,
+            foreground=TEXT_MAIN,
+            font=(gui_font_family, 11, "bold"),
+            anchor="w",
+            justify="left",
+            wraplength=440,
+        ).pack(fill="x", pady=(3, 2))
